{
  "appId": "io.github.teninz.shadowfox",
  "appName": "ShadowFox Eng",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#14171C"
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_learn",
      "iconColor": "#E8853A"
    },
    "SplashScreen": {
      "launchAutoHide": true
    },
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "DARK"
    }
  }
}
