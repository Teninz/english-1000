<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg">

    <LinearLayout android:id="@+id/widget_text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="14dp" android:clickable="true" android:focusable="true">

        <TextView android:id="@+id/widget_eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="ПОВТОРИТЬ · 12 СЛОВ" android:textColor="#A3A8B3" android:textSize="10sp" android:letterSpacing="0.08" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />

        <TextView android:id="@+id/widget_word" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
            android:text="assume" android:textColor="#F1ECE3" android:textSize="26sp" android:fontFamily="serif" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />

        <TextView android:id="@+id/widget_ru" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="предполагать, допускать" android:textColor="#EFA537" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />

        <TextView android:id="@+id/widget_ex" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="5dp"
            android:text="I assume you have read the report." android:textColor="#A3A8B3" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>

    <View android:layout_width="2dp" android:layout_height="match_parent" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" android:background="#E8853A" />

    <LinearLayout android:layout_width="72dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
        <ImageView android:id="@+id/widget_play" android:layout_width="52dp" android:layout_height="52dp"
            android:src="@drawable/ic_widget_play" android:contentDescription="Озвучить" android:padding="4dp" />
        <TextView android:id="@+id/widget_next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:text="1/12 · далее" android:textColor="#E8853A" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:padding="6dp" android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
