<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ShadowFox" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#14171C</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.ShadowFox.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#14171C</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ShadowFox</item>
    </style>
</resources>
